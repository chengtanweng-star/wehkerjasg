<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- ========================================================= -->
  <!-- BAHAGIAN BOLEH DIUBAH: SEO & TAJUK HALAMAN               -->
  <!-- ========================================================= -->
  <title>EasyStore - Menangi Hati Pelanggan Anda</title>
  <meta name="description" content="Platform Pengalaman Pelanggan Bersepadu (UCX) untuk menghubungkan perniagaan anda di mana sahaja pelanggan anda berada.">
  <link rel="icon" type="image/png" href="https://resources.easystore.co/website/images/logo/svg/easystore-logo-horizontal.svg">

  <!-- Pustaka CSS (Tailwind CSS untuk gaya moden & mudah diedit) -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white font-sans antialiased">

  <!-- ========================================================= -->
  <!-- BAR PENGUMUMAN (ANNOUNCEMENT BAR)                         -->
  <!-- ========================================================= -->
  <div id="announcement-bar" class="bg-gradient-to-r from-blue-900 to-blue-600 text-white text-sm py-2 px-4 text-center relative flex justify-center items-center gap-2">
    <span><strong>Sokongan Akhir Tahun:</strong> Nikmati diskaun 50% untuk langganan pelan Business hari ini! (Terhad 30 pengguna pertama)</span>
    <a href="https://admin.easystore.co/subscription/business?promo_code=oct-79606" target="_blank" class="bg-yellow-400 hover:bg-yellow-300 text-black font-semibold text-xs py-1 px-3 rounded-full transition">
      Guna Kod Promo
    </a>
  </div>

  <!-- ========================================================= -->
  <!-- NAVIGASI UTAMA (HEADER / MENU)                            -->
  <!-- ========================================================= -->
  <header class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#">
      <img src="https://resources.easystore.co/website/images/logo/svg/easystore-logo-horizontal-white.svg" alt="EasyStore Logo" class="w-36">
    </a>

    <nav class="hidden md:flex items-center space-x-8 font-medium text-sm">
      <a href="#commerce" class="hover:text-yellow-400 transition">Unified Commerce</a>
      <a href="#retail" class="hover:text-yellow-400 transition">Unified Retail</a>
      <a href="#marketing" class="hover:text-yellow-400 transition">Unified Marketing</a>
      <a href="#loyalty" class="hover:text-yellow-400 transition">Unified Loyalty</a>
      <a href="#daftar" class="hover:text-yellow-400 transition">Pendaftaran</a>
      <a href="#harga" class="hover:text-yellow-400 transition">Harga</a>
    </nav>

    <div class="flex items-center space-x-4">
      <a href="https://admin.easystore.co/login" class="text-sm font-semibold hover:underline">Log Masuk</a>
      <a href="https://admin.easystore.co/signup" class="bg-yellow-400 hover:bg-yellow-300 text-black font-bold text-sm px-4 py-2 rounded-lg transition">
        Cuba Percuma
      </a>
    </div>
  </header>

  <!-- ========================================================= -->
  <!-- SEKSYEN UTAMA (HERO SECTION)                              -->
  <!-- ========================================================= -->
  <section class="relative max-w-7xl mx-auto px-6 py-20 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-12">
    <div class="md:w-1/2 space-y-6">
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight">
        <i>UCX</i> - Menangi Hati Pelanggan Di Setiap Saat
      </h1>
      <p class="text-gray-300 text-lg">
        Menghubungkan jenama anda dengan pelanggan merentasi platform jualan, pemasaran, dan ganjaran kesetiaan menggunakan kuasa AI.
      </p>
      <div class="flex flex-wrap gap-4 justify-center md:justify-start">
        <a href="#daftar" class="bg-yellow-400 hover:bg-yellow-300 text-black font-bold px-6 py-3 rounded-lg text-lg transition">
          Daftar Sekarang &rarr;
        </a>
        <a href="/contact" class="border border-white hover:bg-white hover:text-black font-semibold px-6 py-3 rounded-lg text-lg transition">
          Hubungi Kami
        </a>
      </div>
      
      <div class="flex items-center gap-3 pt-4 justify-center md:justify-start">
        <span class="text-yellow-400 text-xl font-bold">★ 4.7 / 5.0</span>
        <span class="text-sm text-gray-400">Berdasarkan ulasan pelanggan di Google</span>
      </div>
    </div>

    <div class="md:w-1/2 w-full rounded-2xl overflow-hidden shadow-2xl border border-gray-800">
      <video class="w-full h-auto object-cover" autoplay muted loop playsinline>
        <source src="https://resources.easystore.co/website/images/home/2025/v1/video/ucx-hero.mp4" type="video/mp4">
      </video>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- CIRI-CIRI UTAMA (4 PILLAR UCX)                             -->
  <!-- ========================================================= -->
  <section class="bg-gray-800 py-16">
    <div class="max-w-7xl mx-auto px-6 space-y-16">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h2 class="text-3xl md:text-4xl font-bold">Satu Platform. Semua Hubungan Pelanggan.</h2>
        <p class="text-gray-400">Gabungkan e-dagang, jualan fizikal, pemasaran, dan ganjaran dalam satu sistem yang mudah diuruskan.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div id="commerce" class="bg-gray-900 p-6 rounded-xl border border-gray-700 hover:border-yellow-400 transition space-y-4">
          <h3 class="text-xl font-bold text-yellow-400">Unified Commerce</h3>
          <p class="text-gray-300 text-sm">Biar pelanggan membeli dalam talian di mana sahaja mereka melayari.</p>
        </div>
        <div id="retail" class="bg-gray-900 p-6 rounded-xl border border-gray-700 hover:border-yellow-400 transition space-y-4">
          <h3 class="text-xl font-bold text-yellow-400">Unified Retail</h3>
          <p class="text-gray-300 text-sm">Layani pelanggan dengan cara yang sama di kedai fizikal (POS) mahupun dalam talian.</p>
        </div>
        <div id="marketing" class="bg-gray-900 p-6 rounded-xl border border-gray-700 hover:border-yellow-400 transition space-y-4">
          <h3 class="text-xl font-bold text-yellow-400">Unified Marketing</h3>
          <p class="text-gray-300 text-sm">Capai pelanggan melalui saluran kegemaran mereka seperti WhatsApp, Emel, dan SMS.</p>
        </div>
        <div id="loyalty" class="bg-gray-900 p-6 rounded-xl border border-gray-700 hover:border-yellow-400 transition space-y-4">
          <h3 class="text-xl font-bold text-yellow-400">Unified Loyalty</h3>
          <p class="text-gray-300 text-sm">Beri ganjaran dan kumpul mata ganjaran secara automatik untuk pembelian berulang.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- SEKSYEN BARU: BORANG PENDAFTARAN & SEMAKAN IC              -->
  <!-- ========================================================= -->
  <section id="daftar" class="py-20 max-w-xl mx-auto px-6">
    <div class="bg-gray-800 p-8 rounded-2xl border border-gray-700 shadow-xl">
      <h2 class="text-2xl font-bold mb-2 text-yellow-400 text-center">Borang Pendaftaran Sistem</h2>
      <p class="text-gray-400 text-sm text-center mb-6">Sila masukkan maklumat anda di bawah untuk semakan dan pendaftaran.</p>
      
      <form id="formDaftar" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Nama Penuh</label>
          <input type="text" id="name" required placeholder="Nama seperti dalam IC" class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-yellow-400 text-white">
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">No. IC (Tanpa sempang -)</label>
          <input type="text" id="ic_number" required placeholder="Cth: 900101015555" class="w-full px-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:border-yellow-400 text-white">
        </div>

        <button type="submit" class="w-full bg-yellow-400 hover:bg-yellow-300 text-black font-bold py-3 rounded-lg transition">
          Hantar Pendaftaran
        </button>
      </form>

      <!-- Tempat Paparan Mesej Berjaya / Ralat -->
      <p id="msg" class="mt-4 text-center font-semibold text-sm"></p>
    </div>
  </section>

  <!-- ========================================================= -->
  <!-- FOOTER (BAWAHAN HALAMAN)                                  -->
  <!-- ========================================================= -->
  <footer class="bg-black text-gray-400 py-12 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <img src="https://resources.easystore.co/website/images/logo/svg/easystore-logo-horizontal-white.svg" alt="EasyStore" class="w-32 mb-4">
        <p class="text-sm">© 2026 EasyStore Commerce Sdn Bhd. Hak Cipta Terelihara.</p>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-3">Pautan Pantas</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="#" class="hover:text-white">Tentang Kami</a></li>
          <li><a href="#" class="hover:text-white">Harga & Pelan</a></li>
          <li><a href="#" class="hover:text-white">Kisah Peniaga</a></li>
          <li><a href="#" class="hover:text-white">Pusat Bantuan</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-3">Hubungi Kami</h4>
        <p class="text-sm">Mempunyai sebarang soalan? Pasukan kami sedia membantu anda 24/7.</p>
        <a href="/contact" class="inline-block mt-3 text-sm text-yellow-400 font-semibold hover:underline">
          Hantar Mesej &rarr;
        </a>
      </div>
    </div>
  </footer>

  <!-- ========================================================= -->
  <!-- KOD JAVASCRIPT UNTUK HANTAR BORANG & SEMAK IC             -->
  <!-- ========================================================= -->
  <script>
    document.getElementById('formDaftar').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value;
      const ic_number = document.getElementById('ic_number').value;
      const msg = document.getElementById('msg');

      msg.innerText = "Sedang menghantar...";
      msg.style.color = "#fbbf24";

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, ic_number })
        });
        const result = await res.json();

        if (result.success) {
          msg.style.color = "#22c55e";
          msg.innerText = result.message;
          document.getElementById('formDarter']?.reset(); // reset borang
          document.getElementById('formDaftar').reset();
        } else {
          msg.style.color = "#ef4444";
          msg.innerText = result.message; // Papar teks "Maaf No IC anda..." atau "senarai hitam"
        }
      } catch (err) {
        msg.style.color = "#ef4444";
        msg.innerText = "Ralat sambungan ke server.";
      }
    });
  </script>

</body>
</html>
